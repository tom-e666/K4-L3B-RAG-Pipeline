# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=0.3

# Advanced Pipeline Configurations
# 1. HyDE (Hypothetical Document Embeddings - Pre-retrieval): true | false
USE_HYDE=false

# 2. Weighted RRF (Weighted Fusion): Trọng số giữa Dense Search và BM25
DENSE_WEIGHT=1.0
BM25_WEIGHT=1.0

# 3. LLM Listwise Reranker (Post-retrieval): true | false
USE_LLM_RERANK=false

